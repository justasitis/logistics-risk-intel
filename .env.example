# ============================================================
# Logistics Risk Intelligence — 통합 환경변수 파일
#
# 사용법: 이 파일을 복사해 같은 위치에 ".env" 를 만들고 값을 입력한다.
#   (PowerShell)  copy .env.example .env
# .env 는 git/zip에 포함되지 않으므로 자격증명을 안전하게 둘 수 있다.
# api_server.py 가 기동 시 이 파일을 자동으로 읽는다.
# OS 환경변수가 이미 설정된 값은 .env 보다 우선한다.
# ============================================================


# ---------- 데이터레이크 (Denodo B-LAP) — 필수 ----------
DATALAKE_BASE_URL=http://dnd.datalake.sk-on.com:9443
DATALAKE_USERNAME=
DATALAKE_PASSWORD=
DATALAKE_TIMEOUT=30


# ---------- MI 정제 (Actify / Dify AgentLab) ----------
# actify_base_url + api_key + user 가 모두 있어야 MI 정제가 동작한다.
ACTIFY_BASE_URL=https://agentlab.sk-on.com/dify
ACTIFY_ENDPOINT_PATH=/v1/chat-messages
ACTIFY_API_KEY=
ACTIFY_USER=
ACTIFY_RESPONSE_MODE=blocking
ACTIFY_TIMEOUT_SECONDS=240
ACTIFY_VERIFY_SSL=true
MI_VDI_MAX_CANDIDATES=30
MI_RUN_STORE_DIR=backend/data/mi_runs


# ---------- Marinesia AIS / 외부 MI (SharePoint 동기화 폴터) ----------
# SharePoint 동기화 폴터 루트. {username} 은 앱 실행 PC의 로그인 사용자명으로
# 자동 치환되므로, 다른 사용자가 열어도 그 사람 경로로 인식된다.
# 하위 파일은 이 루트 기준으로 자동 탐색된다:
#   - AIS:   <루트>\AIS\Marinesia\Current\marinesia_latest.json
#   - 외부 MI: <루트>\MI\current\external_mi_candidates.json
MARINESIA_SHAREPOINT_ROOT=C:\Users\{username}\SK on\Global물류팀 - LogisticsRisk
MARINESIA_DEFAULT_COMPANY=SKBA
MARINESIA_LIVE_HOURS=6
MARINESIA_STALE_WARNING_HOURS=24
MARINESIA_MAX_FILE_SIZE_MB=50


# ---------- 경유항로 (Stop-by, searoute) ----------
# 유럽향 stopby 공란 시 기본값: south_africa(희망봉) 또는 suez
EUROPE_BLANK_STOPBY_DEFAULT=south_africa
# [참고] searoute 1.4.3에는 algorithm 인자가 없어 이 설정은 현재 적용되지 않는다
# (코드가 호환용으로만 유지 — searoute 업그레이드 시를 대비한 예비값)
SEAROUTE_ALGORITHM=astar
STOPBY_ROUTE_CACHE_SIZE=512
STOPBY_MAXIMUM_ROUTES=5000


# ---------- 수동 좌표 레지스트리 ----------
# 비우면 <프로젝트 루트>/data/manual_coordinates.json 사용.
# SharePoint 동기화 폴터의 파일을 쓰려면 아래처럼 지정 ({username} 자동 치환).
MANUAL_COORDINATE_FILE=C:\Users\{username}\SK on\Global물류팀 - LogisticsRisk\manual_coordinates.json
